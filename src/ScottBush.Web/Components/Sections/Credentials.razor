<section class="creds" aria-labelledby="creds-title">
    <div class="wrap">
        <h2 id="creds-title" class="vh">Certifications and education</h2>
        <ul class="creds-list">
            @foreach (var c in Resume.Credentials)
            {
                <li>
                    <span class="cred-by">@c.IssuedBy</span>
                    @if (c.VerifyUrl is null)
                    {
                        <span class="cred-name">@c.Name</span>
                    }
                    else
                    {
                        <a class="cred-name" href="@c.VerifyUrl" aria-label="@c.Name, @c.IssuedBy: verify">@c.Name</a>
                    }
                </li>
            }
        </ul>
    </div>
</section>
