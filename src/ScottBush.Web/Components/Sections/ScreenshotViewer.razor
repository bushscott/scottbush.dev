<dialog class="viewer" id="viewer" aria-label="Enlarged screenshot">
    <button class="close" id="viewer-close" type="button">Close</button>
    <picture>
        <source id="viewer-avif" type="image/avif" />
        <img id="viewer-img" alt="" />
    </picture>
    <p id="viewer-cap"></p>
</dialog>
