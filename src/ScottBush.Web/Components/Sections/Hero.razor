@using System.Text.Json
<section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
        <div data-heroes="@HeroesJson">
            <h1 id="hero-title" class="@(Heroes.Default.IsLong ? "long" : null)">@Heroes.Default.Headline</h1>
            <p class="lede" id="hero-lede">@Heroes.Default.Description</p>
            @* One pair per visit, chosen before first paint so nothing visibly swaps. The markup
               above is the no-JavaScript default; ?hero=1–5 pins one for review. *@
            @InlineScripts.HeroPicker
            <div class="actions">
                <a class="btn btn-primary" href="mailto:@Profile.Email">Email me<span class="vh"> (opens your email app)</span></a>
                <a class="btn btn-secondary" href="@Profile.ResumePdf" download>Download résumé (PDF)</a>
            </div>
            <p class="where"><span>@Profile.Location</span><a href="@Profile.LinkedIn"><LinkedInIcon />LinkedIn</a><a href="@Profile.GitHub"><GitHubIcon />GitHub</a></p>
        </div>

        <PiRack />
    </div>
</section>

@code {
    private static readonly string HeroesJson = JsonSerializer.Serialize(
        Heroes.All.Select(h => new { headline = h.Headline, description = h.Description, isLong = h.IsLong }));
}
